// Diagrama de banco de dados - Industria de Bebidas (MySQL 8.0.16+)
// Tipos, nomes de constraints e acoes referenciais iguais aos do schema.sql.
// Funcoes auxiliares e triggers de validacao cruzada estao no schema.sql (nao sao representaveis no DBML):
//   - fn_insumo_un_inteira, fn_data_nao_futura, fn_setor_ativo, fn_fornecedor_ativo
//   - trg_movimentacoes_before_insert, trg_movimentacoes_before_update
//   - trg_insumos_before_insert, trg_insumos_before_update

Table usuarios {
  id bigint [primary key, increment]
  nome varchar(150) [not null]
  login varchar(50) [not null, unique, note: "username"]
  senha_hash varchar(255) [not null, note: "BCrypt - nunca senha em texto puro"]
  ativo tinyint(1) [not null, default: 1]

  checks {
    `ativo IN (0,1)` [name: 'ck_usuarios_ativo']
  }
}

Table setores {
  id bigint [primary key, increment]
  nome varchar(150) [not null, note: 'unico apenas entre setores ATIVOS: garantido pelo Service (decisao da equipe); sem indice unico no banco']
  descricao varchar(255)
  ativo tinyint(1) [not null, default: 1]

  indexes {
    (nome, ativo) [name: 'idx_setores_nome_ativo']
  }

  checks {
    `ativo IN (0,1)` [name: 'ck_setores_ativo']
  }
}

Table fornecedores {
  id bigint [primary key, increment]
  nome varchar(150) [not null]
  cnpj char(14) [not null, unique, note: '14 digitos, sem mascara']
  telefone varchar(20)
  ativo tinyint(1) [not null, default: 1]

  indexes {
    nome [name: 'idx_fornecedores_nome']
  }

  checks {
    `cnpj REGEXP '^[0-9]{14}$'` [name: 'ck_fornecedores_cnpj_digitos']
    `ativo IN (0,1)` [name: 'ck_fornecedores_ativo']
  }
}

Table insumos {
  id bigint [primary key, increment]
  nome varchar(150) [not null]
  unidade_medida enum("UN", "KG", "L") [not null, note: 'UN -> quantidades inteiras; KG/L -> ate 3 casas decimais']
  quantidade_atual decimal(15,3) [not null, default: 0, note: 'alterada somente por movimentacao (RN-01)']
  estoque_minimo decimal(15,3) [not null, note: 'alerta quando quantidade_atual <= estoque_minimo (e insumo ativo).']
  fornecedor_id bigint [not null, note: 'FK para fornecedores; trigger exige fornecedor ativo (RN-11)']
  ativo tinyint(1) [not null, default: 1]

  indexes {
    (ativo, nome) [name: 'idx_insumos_nome_ativo']
    fornecedor_id [name: 'idx_insumos_fornecedor']
  }

  checks {
    `ativo IN (0,1)` [name: 'ck_insumos_ativo']
    `quantidade_atual >= 0` [name: 'ck_insumos_saldo']
    `estoque_minimo >= 0` [name: 'ck_insumos_minimo']
    `unidade_medida <> 'UN' OR (quantidade_atual = FLOOR(quantidade_atual) AND estoque_minimo = FLOOR(estoque_minimo))` [name: 'ck_insumos_un_inteira']
  }
}

Table movimentacoes {
  id bigint [primary key, increment]
  insumo_id bigint [not null]
  tipo enum("ENTRADA", "SAIDA") [not null, note: 'SAIDA exige setor_id de setor ativo e nao recebe lote/validade enquanto ENTRADA tem lote/validade como opcional']
  quantidade decimal(15,3) [not null]
  setor_id bigint [note: 'obrigatorio em SAIDA (setor ativo); opcional em ENTRADA.']
  usuario_id bigint [not null, note: 'vem do JWT, nunca do corpo']
  data_movimentacao date [not null, note: 'data operacional informada pelo cliente; nao pode ser futura (validado no Service)']
  data_registro timestamp(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: 'gerado pelo servidor; guardado em UTC e convertido pelo fuso da sessao']
  lote varchar(50)
  validade date [note: 'apenas em ENTRADA; nao anterior a data_movimentacao']
  saldo_anterior decimal(15,3) [not null]
  saldo_atual decimal(15,3) [not null, note: 'saldo_anterior +- quantidade']

  Note: 'sem edicao ou exclusao (RN-07); FKs com ON DELETE/UPDATE RESTRICT'

  indexes {
    (insumo_id, data_registro) [name: 'idx_mov_insumo_registro']
    (data_registro [desc], id [desc]) [name: 'idx_mov_registro_id']
    data_movimentacao [name: 'idx_mov_data']
    setor_id [name: 'idx_mov_setor']
    usuario_id [name: 'idx_mov_usuario']
    (tipo, data_registro) [name: 'idx_mov_tipo_data']
  }

  checks {
    `quantidade > 0` [name: 'ck_mov_quantidade']
    `saldo_anterior >= 0` [name: 'ck_mov_saldo_anterior']
    `saldo_atual >= 0` [name: 'ck_mov_saldo_atual']
    `tipo = 'ENTRADA' OR setor_id IS NOT NULL` [name: 'ck_mov_setor_saida']
    `tipo = 'ENTRADA' OR (lote IS NULL AND validade IS NULL)` [name: 'ck_mov_sem_lote_saida']
    `validade IS NULL OR validade >= data_movimentacao` [name: 'ck_mov_validade']
    `(tipo = 'ENTRADA' AND saldo_atual = saldo_anterior + quantidade) OR (tipo = 'SAIDA' AND saldo_atual = saldo_anterior - quantidade)` [name: 'ck_mov_saldo_calc']
  }
}

Ref: insumos.fornecedor_id > fornecedores.id [delete: restrict, update: restrict] // N insumos : 1 fornecedor
Ref: movimentacoes.insumo_id > insumos.id [delete: restrict, update: restrict] // N movimentacoes : 1 insumo
Ref: movimentacoes.usuario_id > usuarios.id [delete: restrict, update: restrict] // N movimentacoes : 1 usuario
Ref: movimentacoes.setor_id >? setores.id [delete: restrict, update: restrict] // N movimentacoes : 0..1 setor (obrigatorio em SAIDA)

// Funcoes auxiliares e triggers de validacao estao definidos no schema.sql:
// fn_insumo_un_inteira, fn_data_nao_futura, fn_setor_ativo, fn_fornecedor_ativo
// trg_movimentacoes_before_insert, trg_movimentacoes_before_update
// trg_insumos_before_insert, trg_insumos_before_update
