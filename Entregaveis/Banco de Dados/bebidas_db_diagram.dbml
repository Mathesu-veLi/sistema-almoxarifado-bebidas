Table usuarios {
  id integer [primary key, increment]
  nome varchar(150) [not null]
  login varchar(50) [not null, unique, note: "username"]
  senha_hash varchar(255) [not null]
  ativo boolean [not null, default: true]
}

Table setores {
  id integer [primary key, increment]
  nome varchar(150) [not null, unique]
  descricao varchar(255)
  ativo boolean [not null, default: true]

  indexes {
    nome [name: 'idx_setores_nome']
  }
}

Table fornecedores {
  id integer [primary key, increment]
  nome varchar(150) [not null]
  cnpj char(14) [not null, unique]
  telefone varchar(20)
  ativo boolean [not null, default: true]

  indexes {
    nome [name: 'idx_fornecedores_nome']
  }
}

Table insumos {
  id integer [primary key, increment]
  nome varchar(150) [not null]
  unidade_medida enum("UN", "KG", "L") [not null]
  quantidade_atual decimal(15,3) [not null, default: 0]
  estoque_minimo decimal(15,3) [not null, note: 'alerta quando quantidade_atual <= estoque_minimo (e insumo ativo).']
  fornecedor_id integer [not null]
  ativo boolean [not null, default: true]

  indexes {
    (nome, ativo) [name: 'idx_insumos_nome_ativo']
    fornecedor_id [name: 'idx_insumos_fornecedor']
  }
}

Table movimentacoes {
  id integer [primary key, increment]
  insumo_id integer [not null]
  tipo enum("ENTRADA", "SAIDA") [not null, note: 'SAIDA exige setor_id de setor ativo e não recebe lote/validade equanto ENTRADA tem lote/validade como opcional']
  quantidade decimal(15,3) [not null]
  setor_id integer [note: 'obrigatorio em SAIDA e nulo em ENTRADA.']
  usuario_id integer [not null]
  data_movimentacao date [not null, note: 'data operacional informada pelo cliente']
  data_registro timestamp [not null, note: 'gerado pelo servidor']
  lote varchar(50)
  validade date
  saldo_anterior decimal(15,3) [not null]
  saldo_atual decimal(15,3) [not null, note: 'saldo_anterior +- quantidade']

  Note: 'sem edição ou exclusão'

  indexes {
    (insumo_id, data_registro) [name: 'idx_mov_insumo_registro']
    data_movimentacao [name: 'idx_mov_data']
    setor_id [name: 'idx_mov_setor']
    usuario_id [name: 'idx_mov_usuario']
    tipo [name: 'idx_mov_tipo']
  }
}

Ref: insumos.fornecedor_id > fornecedores.id // N insumos : 1 fornecedor
Ref: movimentacoes.insumo_id > insumos.id // N movimentações : 1 insumo
Ref: movimentacoes.usuario_id > usuarios.id // N movimentações : 1 usuário
Ref: movimentacoes.setor_id >? setores.id // N movimentações : 0..1 setor (obrigatório em SAIDA)
