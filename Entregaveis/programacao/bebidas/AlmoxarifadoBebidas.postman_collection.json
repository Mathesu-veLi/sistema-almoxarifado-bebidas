  "item": [
    {
      "name": "🔐 Usuários e Autenticação",
      "item": [
        {
          "name": "POST /api/usuarios (cadastro público)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"João Silva\",\n  \"email\": \"joao@empresa.com\",\n  \"senha\": \"Senha@123\",\n  \"ativo\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios"
              ]
            },
            "description": "Cadastro de usuário (público, sem JWT). RN-14."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 ou 200', function () { pm.response.to.have.status(201); });",
                  "pm.test('Retorna usuario sem senha', function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json).to.not.have.property('senha');",
                  "  pm.expect(json).to.have.property('id');",
                  "});",
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  pm.collectionVariables.set('usuarioId', String(pm.response.json().id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/login (login público)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"joao@empresa.com\",\n  \"senha\": \"Senha@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Login de usuário (público, sem JWT). Retorna token JWT com expiração 3600s."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Retorna token JWT', function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json).to.have.property('token');",
                  "});",
                  "if (pm.response.code === 200) { pm.collectionVariables.set('token', json.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/usuarios/me (perfil autenticado)",
